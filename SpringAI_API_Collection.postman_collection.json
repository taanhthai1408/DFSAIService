            "url": { "raw": "{{baseUrl}}/api/ai/tools/all", "host": ["{{baseUrl}}"], "path": ["api","ai","tools","all"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Thời tiết Hà Nội hôm nay và 25 * 4 bằng bao nhiêu?\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Vision (Multimodal)",
      "item": [
        {
          "name": "26. Analyze Image from URL",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/ai/vision/url?imageUrl=https://upload.wikimedia.org/wikipedia/commons/thumb/4/47/PNG_transparency_demonstration_1.png/280px-PNG_transparency_demonstration_1.png",
              "host": ["{{baseUrl}}"],
              "path": ["api","ai","vision","url"],
              "query": [{ "key": "imageUrl", "value": "https://upload.wikimedia.org/wikipedia/commons/thumb/4/47/PNG_transparency_demonstration_1.png/280px-PNG_transparency_demonstration_1.png" }]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Bức ảnh này mô tả điều gì? Hãy giải thích chi tiết.\"\n}"
            }
          }
        },
        {
          "name": "27. Describe Image",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/ai/vision/describe?imageUrl=https://upload.wikimedia.org/wikipedia/commons/thumb/4/47/PNG_transparency_demonstration_1.png/280px-PNG_transparency_demonstration_1.png",
              "host": ["{{baseUrl}}"],
              "path": ["api","ai","vision","describe"],
              "query": [{ "key": "imageUrl", "value": "https://upload.wikimedia.org/wikipedia/commons/thumb/4/47/PNG_transparency_demonstration_1.png/280px-PNG_transparency_demonstration_1.png" }]
            }
          }
        }
      ]
    }
  ]
